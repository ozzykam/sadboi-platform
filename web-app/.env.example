# Development-only local artwork preview:
# SADBOI_MODE=preview
# Production defaults to locked unless staff mode is explicitly enabled.
# Staff access (use this exact origin when visiting the local app):
SADBOI_MODE=staff
SADBOI_AUTH_ENV=emulator
SADBOI_APP_ORIGIN=http://127.0.0.1:3100
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# For live: set SADBOI_AUTH_ENV=live and REMOVE all emulator variables.
# Local live server uses gcloud auth application-default login credentials.
# Google-hosted servers can use their assigned service identity.
# Vercel: add FIREBASE_ADMIN_CREDENTIALS as a Production Secret in the dashboard.
# Its value is the ENTIRE downloaded service-account JSON for sadboi-platform.
# Do not add outer quotes or prefix the name with NEXT_PUBLIC_.
# Leave it unset locally to keep using your gcloud login; do not commit a key.
# FIREBASE_ADMIN_CREDENTIALS=<service-account JSON set only in Vercel>
# Production SADBOI_APP_ORIGIN must be HTTPS.
# Vercel deployment instructions: docs/33-vercel-deployment.md

# Test-mode Stripe Checkout (server-only; never NEXT_PUBLIC_).
# Enable only after configuring the test account and its signed webhook.
SADBOI_STRIPE_ENABLED=0
# STRIPE_ACCOUNT_ID=acct_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Keep the previous test account configured while draining its orders/events:
# STRIPE_PREVIOUS_ACCOUNT_ID=acct_...
# STRIPE_PREVIOUS_SECRET_KEY=sk_test_...
# STRIPE_PREVIOUS_WEBHOOK_SECRET=whsec_...
# Cloud Scheduler sends Authorization: Bearer <this random 32+ character secret>
# SADBOI_EXPIRY_SECRET=<random secret>
# Setup and account handoff: docs/35-order-lifecycle-stripe.md

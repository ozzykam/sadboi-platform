{
  "name": "sadboi-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sadboi/web dev",
    "build": "pnpm --filter @sadboi/web build",
    "start": "pnpm --filter @sadboi/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @sadboi/web lint",
    "test": "pnpm --filter @sadboi/core test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:firebase-config && pnpm test:firebase-runtime && pnpm build",
    "test:firebase-runtime": "node --no-experimental-require-module --test scripts/firebase-runtime.test.mjs",
    "test:firebase-config": "node --conditions=react-server --experimental-strip-types --test scripts/firebase-credentials.test.mjs",
    "test:gallery": "firebase emulators:exec --only auth,firestore,storage --project demo-sadboi-platform \"node scripts/auth-integration.mjs --artworks --gallery\"",
    "firebase": "firebase",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-sadboi-platform",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project demo-sadboi-platform \"node --test scripts/firebase-rules.test.mjs\"",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs\"",
    "test:workspace": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --workspace\"",
    "test:contacts": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --contacts\"",
    "test:commissions": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --contacts --commissions\"",
    "test:proposals": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --contacts --commissions --proposals\"",
    "test:agreements": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --agreements\"",
    "test:commission-billing": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --commission-billing\"",
    "test:events": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --events\"",
    "test:public-inquiries": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --public-inquiries\"",
    "test:store-orders": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders\"",
    "test:fulfillment": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment\"",
    "test:store-payments": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments\"",
    "test:order-lifecycle": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle\"",
    "test:order-emails": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle --order-emails\"",
    "test:order-emails-disabled": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --order-emails-disabled\"",
    "test:shipping": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle --order-emails --shipping\"",
    "test:after-sales": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle --order-emails --shipping --after-sales\"",
    "test:shipment-cases": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle --order-emails --shipping --after-sales --shipment-cases\"",
    "test:disputes": "firebase emulators:exec --only auth,firestore --project demo-sadboi-platform \"node scripts/auth-integration.mjs --store-orders --fulfillment --store-payments --order-lifecycle --order-emails --shipping --after-sales --shipment-cases --disputes\"",
    "staff:bootstrap": "node scripts/bootstrap-staff.cjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "test:artwork": "firebase emulators:exec --only auth,firestore,storage --project demo-sadboi-platform \"node scripts/auth-integration.mjs --artworks\"",
    "test:inventory": "firebase emulators:exec --only auth,firestore,storage --project demo-sadboi-platform \"node scripts/auth-integration.mjs --artworks --inventory\"",
    "test:purchasing": "firebase emulators:exec --only auth,firestore,storage --project demo-sadboi-platform \"node scripts/auth-integration.mjs --artworks --inventory --purchasing\""
  },
  "devDependencies": {
    "firebase-tools": "15.30.1",
    "prettier": "^3.9.9"
  }
}
